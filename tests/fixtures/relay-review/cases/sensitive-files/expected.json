{
  "description": "Settings move to env vars, but a .env file and a deploy key are added.",
  "intent": "Read database settings from the environment.",
  "author": "claude-code",
  "must_find": [
    {
      "file": ".env",
      "line": 1,
      "min_severity": "MEDIUM",
      "keywords": [
        ".env",
        "secret",
        "sensitive",
        "credential"
      ]
    }
  ],
  "verdict_not": "approve",
  "bundle": {
    "excluded": [
      ".env",
      "deploy/id_rsa"
    ],
    "included": [
      ".env.example",
      "app/settings.py"
    ],
    "redacted": []
  }
}
